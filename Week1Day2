//Defining variables with different data types and printing their values and types
//String data type
let userName = "Kiruthiga"
console.log(userName)
console.log(typeof userName)

//String data type
let organization = "TestLeaf"
console.log(organization)
console.log(typeof organization)

//Number data type
let contactNumber = 1234567890
console.log(contactNumber)
console.log(typeof contactNumber)

//Boolean data type
let knowsAutomation = true
console.log(knowsAutomation)
console.log(typeof knowsAutomation)

//Undefined data type
let usesPlayWright
console.log(usesPlayWright)
console.log(typeof usesPlayWright)
